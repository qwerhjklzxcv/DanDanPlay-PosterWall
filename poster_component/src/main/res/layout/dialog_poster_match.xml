<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/match_keyword_et"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/pw_bg_search"
                android:hint="输入番剧名搜索"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="#353535"
                android:textColorHint="#BBBBBB"
                android:textSize="13sp"
                tools:ignore="Autofill,TextFields" />

            <TextView
                android:id="@+id/match_search_bt"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/pw_bg_action"
                android:gravity="center"
                android:text="搜索"
                android:textColor="#2095F4"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/match_loading_pb"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/match_tip_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#999999"
            android:textSize="12sp"
            tools:text="搜索中…" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/match_rv"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="6dp"
            tools:listitem="@layout/item_match_anime" />
    </LinearLayout>
</layout>
