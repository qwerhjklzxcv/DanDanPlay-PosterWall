<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.xyoye.poster_component.ui.wall.PosterWallViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3F3F3"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp">

            <EditText
                android:id="@+id/search_et"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/pw_bg_search"
                android:hint="搜索番剧"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="#353535"
                android:textColorHint="#BBBBBB"
                android:textSize="13sp"
                tools:ignore="Autofill,TextFields" />

            <TextView
                android:id="@+id/refresh_bt"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pw_bg_action"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="刷新"
                android:textColor="#2095F4"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/count_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="共 0 部"
                android:textColor="#353535"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sort_tv"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/pw_bg_chip"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="最近更新 ▾"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filter_tv"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/pw_bg_chip"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="全部 ▾"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/auth_tips_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF4E5"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="未完成开发者认证：刮削和弹幕都不可用。点此查看如何申请 AppId / AppSecret"
            android:textColor="#B26A00"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/series_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="6dp"
                tools:listitem="@layout/item_poster_series" />

            <LinearLayout
                android:id="@+id/empty_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/empty_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="还没有刮削到番剧"
                    android:textColor="#999999"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/add_storage_bt"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pw_bg_action"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="去添加 WebDAV 网盘"
                    android:textColor="#2095F4"
                    android:textSize="13sp"
                    android:visibility="gone" />            </LinearLayout>

            <LinearLayout
                android:id="@+id/progress_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/progress_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxWidth="260dp"
                    android:textColor="#999999"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
