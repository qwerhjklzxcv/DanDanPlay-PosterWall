<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="5dp">

        <ImageView
            android:id="@+id/series_poster_iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/pw_poster_placeholder"
            android:contentDescription="海报"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="H,2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/series_season_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_margin="5dp"
            android:background="@drawable/pw_bg_badge"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/series_poster_iv"
            app:layout_constraintTop_toTopOf="@id/series_poster_iv"
            tools:text="第2季"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/series_rating_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_margin="5dp"
            android:background="@drawable/pw_bg_badge"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:textColor="#FFD54F"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/series_poster_iv"
            app:layout_constraintTop_toTopOf="@id/series_poster_iv"
            tools:text="9.2"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/series_episode_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_margin="5dp"
            android:background="@drawable/pw_bg_badge"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/series_poster_iv"
            app:layout_constraintEnd_toEndOf="@id/series_poster_iv"
            tools:text="12集"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/series_progress_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_margin="5dp"
            android:background="@drawable/pw_bg_badge"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:textColor="#7CD4A0"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/series_poster_iv"
            app:layout_constraintStart_toStartOf="@id/series_poster_iv"
            tools:text="看到 5/12"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/series_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#353535"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/series_poster_iv"
            tools:text="葬送的芙莉莲" />

        <TextView
            android:id="@+id/series_info_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#999999"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/series_title_tv"
            tools:text="2023 · 28 集 · 我的 WebDAV" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
